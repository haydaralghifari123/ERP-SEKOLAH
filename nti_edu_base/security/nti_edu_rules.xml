<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Baris wali mengikuti unit siswa; rule global (berlaku juga untuk Administrator) -->
    <record id="rule_siswa_wali_unit" model="ir.rule">
        <field name="name">Wali siswa: hanya unit sendiri</field>
        <field name="model_id" ref="model_nti_edu_siswa_wali"/>
        <field name="domain_force">[('siswa_id.company_id', 'in', company_ids)]</field>
    </record>

    <!-- Master bersama (jurusan, hari libur, mapel): baca = unit sendiri, yayasan induk, atau tanpa unit
         (aturan global, hanya baca). Tulis lewat aturan grup: operator hanya data unit sendiri,
         administrator boleh juga data tanpa unit. Data tingkat yayasan hanya bisa diubah oleh
         pengguna yang unit diizinkannya mencakup yayasan. -->
    <record id="rule_jurusan_multi_unit" model="ir.rule">
        <field name="name">Jurusan: baca multi-unit</field>
        <field name="model_id" ref="model_nti_edu_jurusan"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_jurusan_tulis_operator" model="ir.rule">
        <field name="name">Jurusan: tulis operator (unit sendiri)</field>
        <field name="model_id" ref="model_nti_edu_jurusan"/>
        <field name="groups" eval="[(4, ref('nti_edu_base.group_base_operator'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="False"/>
    </record>

    <record id="rule_jurusan_tulis_admin" model="ir.rule">
        <field name="name">Jurusan: tulis administrator (termasuk tanpa unit)</field>
        <field name="model_id" ref="model_nti_edu_jurusan"/>
        <field name="groups" eval="[(4, ref('nti_edu_base.group_base_admin'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="False"/>
    </record>

    <record id="rule_hari_libur_multi_unit" model="ir.rule">
        <field name="name">Hari libur: baca multi-unit</field>
        <field name="model_id" ref="model_nti_edu_hari_libur"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_hari_libur_tulis_operator" model="ir.rule">
        <field name="name">Hari libur: tulis operator (unit sendiri)</field>
        <field name="model_id" ref="model_nti_edu_hari_libur"/>
        <field name="groups" eval="[(4, ref('nti_edu_base.group_base_operator'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="False"/>
    </record>

    <record id="rule_hari_libur_tulis_admin" model="ir.rule">
        <field name="name">Hari libur: tulis administrator (termasuk tanpa unit)</field>
        <field name="model_id" ref="model_nti_edu_hari_libur"/>
        <field name="groups" eval="[(4, ref('nti_edu_base.group_base_admin'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="False"/>
    </record>

    <record id="rule_mapel_multi_unit" model="ir.rule">
        <field name="name">Mata pelajaran: baca multi-unit</field>
        <field name="model_id" ref="model_nti_edu_mapel"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_mapel_tulis_operator" model="ir.rule">
        <field name="name">Mata pelajaran: tulis operator (unit sendiri)</field>
        <field name="model_id" ref="model_nti_edu_mapel"/>
        <field name="groups" eval="[(4, ref('nti_edu_base.group_base_operator'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="False"/>
    </record>

    <record id="rule_mapel_tulis_admin" model="ir.rule">
        <field name="name">Mata pelajaran: tulis administrator (termasuk tanpa unit)</field>
        <field name="model_id" ref="model_nti_edu_mapel"/>
        <field name="groups" eval="[(4, ref('nti_edu_base.group_base_admin'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="False"/>
    </record>

    <!-- Model khusus unit: company wajib unit, tanpa tingkat yayasan -->
    <record id="rule_rombel_unit" model="ir.rule">
        <field name="name">Rombel: hanya unit sendiri</field>
        <field name="model_id" ref="model_nti_edu_rombel"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rombel_anggota_unit" model="ir.rule">
        <field name="name">Anggota rombel: hanya unit sendiri</field>
        <field name="model_id" ref="model_nti_edu_rombel_anggota"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_ruang_unit" model="ir.rule">
        <field name="name">Ruang: hanya unit sendiri</field>
        <field name="model_id" ref="model_nti_edu_ruang"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Mitra eksternal (DU/DI): siswa dan wali disembunyikan dari res.partner. Aturan grup, jadi
         hanya membatasi anggota grup eksternal. -->
    <record id="rule_partner_eksternal" model="ir.rule">
        <field name="name">Eksternal: tanpa siswa dan wali</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('nti_edu_base.group_base_eksternal'))]"/>
        <field name="domain_force">[('nti_edu_is_siswa', '=', False), ('nti_edu_is_wali', '=', False)]</field>
    </record>
</odoo>
