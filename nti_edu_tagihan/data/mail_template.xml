            <td t-out="format_date(tagihan.nti_edu_jatuh_tempo_terbuka or tagihan.invoice_date_due)">10/08/2026</td>
            <td t-out="format_amount(tagihan.amount_residual, tagihan.currency_id)">Rp 150.000</td>
        </tr>
    </table>
    <p>Abaikan pesan ini bila tagihan sudah dibayar.</p>
    <p>Terima kasih.</p>
</div>
        </field>
    </record>

    <record id="mail_template_ringkasan_tunggakan" model="mail.template">
        <field name="name">Keuangan Sekolah: Ringkasan Tunggakan</field>
        <field name="model_id" ref="base.model_res_partner"/>
