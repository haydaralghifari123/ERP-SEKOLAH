<?xml version="1.0" encoding="utf-8"?>
<!-- Data demo NTI Edu (nama dan data fiktif; domain email example.com). -->
<odoo noupdate="1">
    <!-- Entitas -->
    <record id="demo_yayasan" model="res.company">
        <field name="name">Yayasan Pendidikan Nusantara</field>
        <field name="nti_edu_jenis">yayasan</field>
    </record>
    <record id="demo_unit_smp" model="res.company">
        <field name="name">SMP Nusantara 1</field>
        <field name="parent_id" ref="demo_yayasan"/>
        <field name="nti_edu_jenis">unit</field>
        <field name="nti_edu_jenjang_id" ref="jenjang_smp"/>
        <field name="nti_edu_kode">smp1</field>
        <field name="nti_edu_hari_sekolah">5</field>
    </record>
    <record id="demo_unit_sma" model="res.company">
        <field name="name">SMA Nusantara 1</field>
        <field name="parent_id" ref="demo_yayasan"/>
        <field name="nti_edu_jenis">unit</field>
        <field name="nti_edu_jenjang_id" ref="jenjang_sma"/>
        <field name="nti_edu_kode">sma1</field>
        <field name="nti_edu_hari_sekolah">6</field>
    </record>

    <!-- Admin Odoo boleh melihat entitas demo (res.company.create hanya menautkan superuser saat instalasi) -->
    <record id="base.user_admin" model="res.users">
        <field name="company_ids" eval="[(4, ref('demo_yayasan')), (4, ref('demo_unit_smp')), (4, ref('demo_unit_sma'))]"/>
    </record>

    <!-- Kalender akademik -->
    <record id="demo_tahun_2026" model="nti_edu.tahun.ajaran">
        <field name="name">2026/2027</field>
