<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_nti_edu_tagihan" model="ir.module.category">
        <field name="name">NTI Edu / Tagihan</field>
        <field name="sequence">42</field>
    </record>

    <!-- Grup tagihan sengaja tidak meng-imply account.group_account_*: rule "lihat semua" grup akuntansi
         akan membatalkan pembatasan cakupan pembukuan (spec §4.11). -->
    <record id="group_tagihan_pemantau" model="res.groups">
        <field name="name">Pemantau Keuangan</field>
        <field name="category_id" ref="module_category_nti_edu_tagihan"/>
        <field name="implied_ids" eval="[(4, ref('nti_edu_base.group_base_pengguna'))]"/>
    </record>

    <record id="group_tagihan_bendahara" model="res.groups">
        <field name="name">Bendahara Unit</field>
        <field name="category_id" ref="module_category_nti_edu_tagihan"/>
        <field name="implied_ids" eval="[(4, ref('group_tagihan_pemantau'))]"/>
    </record>

    <record id="group_tagihan_admin" model="res.groups">
        <field name="name">Admin Keuangan</field>
        <field name="category_id" ref="module_category_nti_edu_tagihan"/>
        <field name="implied_ids" eval="[(4, ref('group_tagihan_bendahara'))]"/>
    </record>

    <!-- Admin Sistem otomatis Admin Keuangan. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_tagihan_admin'))]"/>
    </record>

    <!-- Master konfigurasi: terlihat bila tanpa unit, milik yayasan induk, atau milik unit yang diizinkan. -->
    <record id="rule_komponen_multi_unit" model="ir.rule">
        <field name="name">Komponen biaya: multi-unit</field>
        <field name="model_id" ref="model_nti_edu_tagihan_komponen"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
    </record>
    <record id="rule_periode_jenis_multi_unit" model="ir.rule">
        <field name="name">Periode tagihan: multi-unit</field>
        <field name="model_id" ref="model_nti_edu_tagihan_periode_jenis"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
    </record>
    <record id="rule_aturan_denda_multi_unit" model="ir.rule">
        <field name="name">Aturan denda: multi-unit</field>
        <field name="model_id" ref="model_nti_edu_tagihan_aturan_denda"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
    </record>
    <record id="rule_aturan_cicilan_multi_unit" model="ir.rule">
        <field name="name">Aturan cicilan: multi-unit</field>
        <field name="model_id" ref="model_nti_edu_tagihan_aturan_cicilan"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
    </record>
    <record id="rule_aturan_masuk_multi_unit" model="ir.rule">
        <field name="name">Aturan siswa masuk tengah: multi-unit</field>
        <field name="model_id" ref="model_nti_edu_tagihan_aturan_masuk"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
    </record>
    <record id="rule_rekening_multi_unit" model="ir.rule">
        <field name="name">Rekening pembayaran: multi-unit</field>
        <field name="model_id" ref="model_nti_edu_tagihan_rekening"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
    </record>
    <record id="rule_alasan_tolak_multi_unit" model="ir.rule">
        <field name="name">Alasan penolakan transfer: multi-unit</field>
        <field name="model_id" ref="model_nti_edu_tagihan_alasan_tolak"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
    </record>
    <record id="rule_alasan_hapus_multi_unit" model="ir.rule">
        <field name="name">Alasan penghapusan denda: multi-unit</field>
        <field name="model_id" ref="model_nti_edu_tagihan_alasan_hapus"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', company_ids)]</field>
    </record>
</odoo>
