<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "-group_base_pengguna": groups menuitem hanya ditambahkan saat pembaruan modul; hapus grup pengguna yang
         sempat dipasang pada akar ini (versi sebelumnya), agar app ini hanya terlihat grup tagihan. -->
    <menuitem id="menu_tagihan_root" name="Keuangan Sekolah" sequence="45"
              groups="nti_edu_tagihan.group_tagihan_pemantau,-nti_edu_base.group_base_pengguna"/>

    <menuitem id="menu_tagihan" name="Tagihan" parent="menu_tagihan_root"
              action="action_tagihan" sequence="10" groups="nti_edu_tagihan.group_tagihan_pemantau"/>
    <menuitem id="menu_konfirmasi" name="Konfirmasi Transfer" parent="menu_tagihan_root"
              action="action_konfirmasi" sequence="15" groups="nti_edu_tagihan.group_tagihan_pemantau"/>
    <menuitem id="menu_pembayaran" name="Pembayaran" parent="menu_tagihan_root"
              action="action_pembayaran" sequence="20" groups="nti_edu_tagihan.group_tagihan_pemantau"/>
    <menuitem id="menu_tunggakan" name="Tunggakan" parent="menu_tagihan_root"
              action="action_tunggakan" sequence="25" groups="nti_edu_tagihan.group_tagihan_pemantau"/>
    <menuitem id="menu_potongan" name="Potongan Siswa" parent="menu_tagihan_root"
              action="action_potongan" sequence="30" groups="nti_edu_tagihan.group_tagihan_pemantau"/>

    <!-- Wali kelas (bukan grup tagihan) membuka tunggakan rombelnya dari app Data Sekolah; app Keuangan Sekolah
         hanya untuk grup tagihan. -->
    <menuitem id="menu_tunggakan_rombel_saya" name="Tunggakan Rombel Saya" parent="nti_edu_base.menu_data_sekolah"
              action="action_tunggakan_rombel_saya" sequence="25" groups="nti_edu_base.group_base_pengguna"/>

    <menuitem id="menu_tagihan_proses" name="Proses" parent="menu_tagihan_root" sequence="40"
              groups="nti_edu_tagihan.group_tagihan_bendahara"/>
    <menuitem id="menu_terima_pembayaran" name="Terima Pembayaran" parent="menu_tagihan_proses"
              action="action_bayar_wizard" sequence="5"/>
    <menuitem id="menu_buat_tagihan" name="Buat Tagihan" parent="menu_tagihan_proses"
              action="action_buat_tagihan_wizard" sequence="10"/>
    <menuitem id="menu_saldo_awal" name="Tunggakan Awal" parent="menu_tagihan_proses"
              action="action_saldo_awal_wizard" sequence="20"/>

    <menuitem id="menu_tagihan_konfigurasi" name="Konfigurasi" parent="menu_tagihan_root" sequence="90"
              groups="nti_edu_tagihan.group_tagihan_admin"/>
    <menuitem id="menu_komponen" name="Komponen Biaya" parent="menu_tagihan_konfigurasi"
              action="action_komponen" sequence="10"/>
    <menuitem id="menu_skema" name="Skema Biaya" parent="menu_tagihan_konfigurasi"
              action="action_skema" sequence="20"/>
    <menuitem id="menu_potongan_jenis" name="Jenis Potongan" parent="menu_tagihan_konfigurasi"
              action="action_potongan_jenis" sequence="30"/>
    <menuitem id="menu_periode_jenis" name="Periode Tagihan" parent="menu_tagihan_konfigurasi"
              action="action_periode_jenis" sequence="40"/>
    <menuitem id="menu_aturan_denda" name="Aturan Denda" parent="menu_tagihan_konfigurasi"
              action="action_aturan_denda" sequence="50"/>
    <menuitem id="menu_aturan_cicilan" name="Aturan Cicilan" parent="menu_tagihan_konfigurasi"
              action="action_aturan_cicilan" sequence="60"/>
    <menuitem id="menu_aturan_masuk" name="Aturan Siswa Masuk Tengah" parent="menu_tagihan_konfigurasi"
              action="action_aturan_masuk" sequence="70"/>
    <menuitem id="menu_rekening" name="Rekening Pembayaran" parent="menu_tagihan_konfigurasi"
              action="action_rekening" sequence="80"/>
    <menuitem id="menu_alasan_tolak" name="Alasan Penolakan Transfer" parent="menu_tagihan_konfigurasi"
              action="action_alasan_tolak" sequence="90"/>
    <menuitem id="menu_alasan_hapus" name="Alasan Penghapusan Denda" parent="menu_tagihan_konfigurasi"
              action="action_alasan_hapus" sequence="100"/>
    <menuitem id="menu_pengaturan" name="Pengaturan" parent="menu_tagihan_konfigurasi"
              action="action_pengaturan" sequence="200"/>
</odoo>
