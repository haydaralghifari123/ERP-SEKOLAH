<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mapel_list" model="ir.ui.view">
        <field name="name">nti_edu.mapel.list</field>
        <field name="model">nti_edu.mapel</field>
        <field name="arch" type="xml">
            <list string="Mata Pelajaran" editable="bottom">
                <field name="name"/>
                <field name="kode"/>
                <field name="kelompok"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="action_mapel" model="ir.actions.act_window">
        <field name="name">Mata Pelajaran</field>
        <field name="res_model">nti_edu.mapel</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
