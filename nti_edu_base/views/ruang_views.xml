<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ruang_list" model="ir.ui.view">
        <field name="name">nti_edu.ruang.list</field>
        <field name="model">nti_edu.ruang</field>
        <field name="arch" type="xml">
            <list string="Ruang" editable="bottom">
                <field name="name"/>
                <field name="kode"/>
                <field name="jenis"/>
                <field name="kapasitas"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="action_ruang" model="ir.actions.act_window">
        <field name="name">Ruang</field>
        <field name="res_model">nti_edu.ruang</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
