<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_nti_edu_pegawai" model="ir.module.category">
        <field name="name">NTI Edu / Pegawai</field>
        <field name="sequence">41</field>
    </record>

    <record id="group_pegawai_operator" model="res.groups">
        <field name="name">TU Pegawai</field>
        <field name="category_id" ref="module_category_nti_edu_pegawai"/>
        <field name="implied_ids" eval="[(4, ref('nti_edu_base.group_base_pengguna')), (4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_pegawai_hrd" model="res.groups">
        <field name="name">HRD Yayasan</field>
        <field name="category_id" ref="module_category_nti_edu_pegawai"/>
        <field name="implied_ids" eval="[(4, ref('group_pegawai_operator'))]"/>
    </record>
</odoo>
