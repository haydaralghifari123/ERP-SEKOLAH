<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tunggakan (spec §4.7): tagihan terbit yang masih bersisa dan cicilan terbuka paling awalnya lewat jatuh
         tempo; list + pivot dengan umur. Domain sama dengan account.move._nti_edu_domain_tunggakan. -->
    <record id="view_tunggakan_list" model="ir.ui.view">
        <field name="name">account.move.list.nti_edu_tunggakan</field>
        <field name="model">account.move</field>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <list string="Tunggakan" create="0" edit="0" delete="0"
                  default_order="nti_edu_jatuh_tempo_terbuka, id">
                <header>
                    <button name="action_nti_edu_kirim_pengingat" type="object" string="Kirim Pengingat"
                            groups="nti_edu_tagihan.group_tagihan_bendahara"
                            confirm="Kirim email ringkasan tunggakan ke wali siswa dari tagihan yang dipilih?"/>
                </header>
                <field name="name"/>
                <field name="nti_edu_siswa_id"/>
                <field name="nti_edu_rombel_id"/>
                <field name="nti_edu_komponen_id"/>
                <field name="nti_edu_periode" optional="show"/>
                <field name="nti_edu_jatuh_tempo_terbuka" string="Jatuh Tempo"/>
                <field name="nti_edu_umur_tunggakan" widget="badge"
                       decoration-warning="nti_edu_umur_tunggakan in ('0_30', '31_60')"
                       decoration-danger="nti_edu_umur_tunggakan in ('61_90', '90_plus')"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_total" string="Total" sum="Total" optional="hide"/>
                <field name="amount_residual" string="Sisa" sum="Sisa"/>
            </list>
        </field>
    </record>

    <record id="view_tunggakan_pivot" model="ir.ui.view">
        <field name="name">account.move.pivot.nti_edu_tunggakan</field>
        <field name="model">account.move</field>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <pivot string="Tunggakan">
                <field name="nti_edu_rombel_id" type="row"/>
                <field name="nti_edu_umur_tunggakan" type="col"/>
                <field name="amount_residual" string="Sisa" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_tunggakan_search" model="ir.ui.view">
        <field name="name">account.move.search.nti_edu_tunggakan</field>
        <field name="model">account.move</field>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <search string="Tunggakan">
                <field name="nti_edu_siswa_id"/>
                <field name="name"/>
                <field name="nti_edu_komponen_id"/>
                <field name="nti_edu_rombel_id"/>
                <filter name="umur_0_30" string="0–30 hari" domain="[('nti_edu_umur_tunggakan', '=', '0_30')]"/>
                <filter name="umur_31_60" string="31–60 hari" domain="[('nti_edu_umur_tunggakan', '=', '31_60')]"/>
                <filter name="umur_61_90" string="61–90 hari" domain="[('nti_edu_umur_tunggakan', '=', '61_90')]"/>
                <filter name="umur_90_plus" string="&gt; 90 hari"
                        domain="[('nti_edu_umur_tunggakan', '=', '90_plus')]"/>
                <separator/>
                <filter name="denda" string="Denda" domain="[('nti_edu_komponen_id.jenis', '=', 'denda')]"/>
                <filter name="bukan_denda" string="Bukan Denda" domain="[('nti_edu_komponen_id.jenis', '!=', 'denda')]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="per_unit" string="Unit" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                    <filter name="per_rombel" string="Rombel" context="{'group_by': 'nti_edu_rombel_id'}"/>
                    <filter name="per_siswa" string="Siswa" context="{'group_by': 'nti_edu_siswa_id'}"/>
                    <filter name="per_komponen" string="Komponen" context="{'group_by': 'nti_edu_komponen_id'}"/>
                    <filter name="per_umur" string="Umur" context="{'group_by': 'nti_edu_umur_tunggakan'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tunggakan" model="ir.actions.act_window">
        <field name="name">Tunggakan</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('nti_edu_is_tagihan', '=', True), ('state', '=', 'posted'), ('amount_residual', '&gt;', 0), ('nti_edu_jatuh_tempo_terbuka', '&lt;', context_today().strftime('%Y-%m-%d'))]</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="view_tunggakan_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_tunggakan_list')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_tunggakan_pivot')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_tagihan_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tidak ada tunggakan</p>
            <p>Tagihan yang lewat jatuh tempo dan belum lunas tampil di sini.</p>
        </field>
    </record>

    <!-- Tunggakan Rombel Saya (wali kelas, spec §4.7): baris dibuat server action setelah pemeriksaan wali kelas. -->
    <record id="view_tunggakan_wali_list" model="ir.ui.view">
        <field name="name">nti_edu.tagihan.tunggakan.wali.list</field>
        <field name="model">nti_edu.tagihan.tunggakan.wali</field>
        <field name="arch" type="xml">
            <list string="Tunggakan Rombel Saya" create="0" edit="0" delete="0">
                <field name="rombel"/>
                <field name="siswa_nama"/>
                <field name="komponen"/>
                <field name="jatuh_tempo"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="sisa" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="action_tunggakan_rombel_saya" model="ir.actions.server">
        <field name="name">Tunggakan Rombel Saya</field>
        <field name="model_id" ref="model_nti_edu_tagihan_tunggakan_wali"/>
        <field name="state">code</field>
        <field name="code">action = model.action_buka_tunggakan_rombel()</field>
        <field name="groups_id" eval="[(4, ref('nti_edu_base.group_base_pengguna'))]"/>
    </record>
</odoo>
