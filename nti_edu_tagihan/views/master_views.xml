    <!-- Aturan siswa masuk tengah -->
    <record id="view_aturan_masuk_list" model="ir.ui.view">
        <field name="name">nti_edu.tagihan.aturan.masuk.list</field>
        <field name="model">nti_edu.tagihan.aturan.masuk</field>
        <field name="arch" type="xml">
            <list string="Aturan Siswa Masuk Tengah" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="cara"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_aturan_masuk" model="ir.actions.act_window">
        <field name="name">Aturan Siswa Masuk Tengah</field>
        <field name="res_model">nti_edu.tagihan.aturan.masuk</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Rekening pembayaran -->
    <record id="view_rekening_list" model="ir.ui.view">
        <field name="name">nti_edu.tagihan.rekening.list</field>
        <field name="model">nti_edu.tagihan.rekening</field>
        <field name="arch" type="xml">
            <list string="Rekening Pembayaran">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="bank"/>
                <field name="nomor"/>
                <field name="atas_nama"/>
                <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
                <field name="journal_id"/>
            </list>
        </field>
    </record>

    <record id="view_rekening_form" model="ir.ui.view">
        <field name="name">nti_edu.tagihan.rekening.form</field>
        <field name="model">nti_edu.tagihan.rekening</field>
        <field name="arch" type="xml">
            <form string="Rekening Pembayaran">
                <sheet>
                    <widget name="web_ribbon" title="Diarsipkan" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="bank"/>
                            <field name="nomor"/>
                            <field name="atas_nama"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <label for="instruksi"/>
                    <field name="instruksi"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rekening" model="ir.actions.act_window">
        <field name="name">Rekening Pembayaran</field>
        <field name="res_model">nti_edu.tagihan.rekening</field>
        <field name="view_mode">list,form</field>
    </record>

