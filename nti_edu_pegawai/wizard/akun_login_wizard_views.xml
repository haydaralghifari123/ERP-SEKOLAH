<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_akun_login_wizard_form" model="ir.ui.view">
        <field name="name">nti_edu.pegawai.akun.wizard.form</field>
        <field name="model">nti_edu.pegawai.akun.wizard</field>
        <field name="arch" type="xml">
            <form string="Buat Akun Login">
                <field name="state" invisible="1"/>
                <group>
                    <field name="employee_id" readonly="state == 'selesai'"/>
                    <field name="login" readonly="state == 'selesai'"/>
                    <field name="password_awal" invisible="state != 'selesai' or not password_awal"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="state != 'selesai' or not password_awal">
                    Catat kata sandi ini dan berikan kepada pemiliknya; tidak akan ditampilkan lagi.
                </div>
                <div class="alert alert-info" role="alert" invisible="state != 'selesai' or password_awal">
                    Undangan pengaturan kata sandi dikirim ke email pemilik akun.
                </div>
                <footer>
                    <button string="Buat Akun" name="action_buat" type="object" class="btn-primary"
                            invisible="state == 'selesai'"/>
                    <button string="Tutup" name="action_tutup" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
