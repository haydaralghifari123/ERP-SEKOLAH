<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Jadwal harian pembuatan tagihan (spec §4.3): hanya unit dengan Tagihan Otomatis. -->
    <record id="cron_buat_tagihan" model="ir.cron">
        <field name="name">Keuangan Sekolah: Buat Tagihan Terjadwal</field>
        <field name="model_id" ref="model_nti_edu_tagihan_mesin"/>
        <field name="state">code</field>
        <field name="code">model._cron_buat_tagihan()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 01:00:00')"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Jadwal harian denda keterlambatan (spec §4.5): dijalankan sesudah pembuatan tagihan. -->
    <record id="cron_denda" model="ir.cron">
        <field name="name">Keuangan Sekolah: Denda Keterlambatan</field>
        <field name="model_id" ref="model_nti_edu_tagihan_mesin"/>
        <field name="state">code</field>
        <field name="code">model._cron_denda()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Jadwal harian umur tunggakan (spec §4.7): umur bergantung pada hari ini, dihitung ulang sebelum pengingat. -->
    <record id="cron_perbarui_umur" model="ir.cron">
        <field name="name">Keuangan Sekolah: Perbarui Umur Tunggakan</field>
        <field name="model_id" ref="model_nti_edu_tagihan_mesin"/>
        <field name="state">code</field>
        <field name="code">model._cron_perbarui_umur()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:30:00')"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Jadwal harian email pengingat jatuh tempo dan ringkasan tunggakan (spec §4.9), menurut pengaturan unit. -->
    <record id="cron_pengingat" model="ir.cron">
        <field name="name">Keuangan Sekolah: Pengingat Tagihan</field>
        <field name="model_id" ref="model_nti_edu_tagihan_mesin"/>
        <field name="state">code</field>
        <field name="code">model._cron_pengingat()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 06:00:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
