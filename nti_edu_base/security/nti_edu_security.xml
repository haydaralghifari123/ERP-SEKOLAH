<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_nti_edu_data_sekolah" model="ir.module.category">
        <field name="name">NTI Edu / Data Sekolah</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_base_pengguna" model="res.groups">
        <field name="name">Pengguna</field>
        <field name="category_id" ref="module_category_nti_edu_data_sekolah"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Hak tulis res.partner bawaan hanya untuk base.group_partner_manager -->
    <record id="group_base_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="category_id" ref="module_category_nti_edu_data_sekolah"/>
        <field name="implied_ids" eval="[(4, ref('group_base_pengguna')), (4, ref('base.group_partner_manager'))]"/>
    </record>

    <record id="group_base_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_nti_edu_data_sekolah"/>
        <field name="implied_ids" eval="[(4, ref('group_base_operator'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_base_eksternal" model="res.groups">
        <field name="name">Eksternal</field>
        <field name="category_id" ref="module_category_nti_edu_data_sekolah"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
