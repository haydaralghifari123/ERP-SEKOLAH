<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kartu SPP siswa per tahun ajaran (spec §4.7). Data dari res.partner._nti_edu_data_kartu_spp lewat
         report.nti_edu_tagihan.report_kartu_spp (pemeriksaan hak di sana). Tidak diikat ke menu Cetak kontak;
         dibuka dari tab Keuangan siswa dan portal. -->
    <record id="action_report_kartu_spp" model="ir.actions.report">
        <field name="name">Kartu SPP</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nti_edu_tagihan.report_kartu_spp</field>
        <field name="report_file">nti_edu_tagihan.report_kartu_spp</field>
        <field name="print_report_name">'Kartu SPP - %s' % (object.name)</field>
    </record>

    <template id="report_kartu_spp_document">
        <t t-call="web.external_layout">
            <t t-set="kartu" t-value="kartu_spp[o.id]"/>
            <t t-set="uang" t-value="kartu['mata_uang']"/>
            <div class="page" style="font-size: 11px;">
                <h4>Kartu SPP</h4>
                <table class="table table-borderless table-sm mb-3" style="width: auto;">
                    <tr><td>Nama Siswa</td><td>: <strong t-out="o.name"/></td></tr>
                    <tr t-if="o.nti_edu_nis"><td>NIS</td><td>: <span t-out="o.nti_edu_nis"/></td></tr>
                    <tr><td>Unit</td><td>: <span t-out="o.company_id.name"/></td></tr>
                    <tr t-if="o.nti_edu_rombel_aktif_id"><td>Rombel</td><td>: <span t-out="o.nti_edu_rombel_aktif_id.name"/></td></tr>
                    <tr><td>Tahun Ajaran</td><td>: <span t-out="kartu['tahun_ajaran'].name"/></td></tr>
                </table>

                <t t-foreach="kartu['bulanan']" t-as="baris">
                    <h6 class="mt-3" t-out="baris['komponen'].name"/>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Bulan</th>
                                <th>Tagihan</th>
                                <th class="text-end">Nominal</th>
                                <th class="text-end">Potongan</th>
                                <th class="text-end">Dibayar</th>
                                <th class="text-end">Sisa</th>
                                <th>Keterangan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="baris['sel']" t-as="sel">
                                <td t-out="sel['nama_bulan']"/>
                                <td><span t-if="sel['tagihan']" t-out="sel['tagihan'].name"/></td>
                                <t t-if="sel['tagihan']">
                                    <td class="text-end"><span t-out="sel['nominal']" t-options="{'widget': 'monetary', 'display_currency': uang}"/></td>
                                    <td class="text-end"><span t-out="sel['potongan']" t-options="{'widget': 'monetary', 'display_currency': uang}"/></td>
                                    <td class="text-end"><span t-out="sel['bayar']" t-options="{'widget': 'monetary', 'display_currency': uang}"/></td>
                                    <td class="text-end"><span t-out="sel['sisa']" t-options="{'widget': 'monetary', 'display_currency': uang}"/></td>
                                </t>
                                <t t-else="">
                                    <td/><td/><td/><td/>
                                </t>
                                <td>
                                    <span t-out="label_status[sel['status']]"/>
                                    <t t-if="sel['tanggal_lunas']"> (<span t-out="sel['tanggal_lunas']" t-options="{'widget': 'date'}"/>)</t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <t t-if="kartu['lainnya']">
                    <h6 class="mt-3">Tagihan Lain dan Denda</h6>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Tagihan</th>
                                <th>Jatuh Tempo</th>
                                <th class="text-end">Nominal</th>
                                <th class="text-end">Potongan</th>
                                <th class="text-end">Dibayar</th>
                                <th class="text-end">Sisa</th>
                                <th>Keterangan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="kartu['lainnya']" t-as="item">
                                <tr>
                                    <td><span t-out="item['nama']"/><br/><small t-out="item['tagihan'].name"/></td>
                                    <td><span t-out="item['jatuh_tempo']" t-options="{'widget': 'date'}"/></td>
                                    <td class="text-end"><span t-out="item['nominal']" t-options="{'widget': 'monetary', 'display_currency': uang}"/></td>
                                    <td class="text-end"><span t-out="item['potongan']" t-options="{'widget': 'monetary', 'display_currency': uang}"/></td>
                                    <td class="text-end"><span t-out="item['bayar']" t-options="{'widget': 'monetary', 'display_currency': uang}"/></td>
                                    <td class="text-end"><span t-out="item['sisa']" t-options="{'widget': 'monetary', 'display_currency': uang}"/></td>
                                    <td>
                                        <span t-out="label_status[item['status']]"/>
                                        <t t-if="item['tanggal_lunas']"> (<span t-out="item['tanggal_lunas']" t-options="{'widget': 'date'}"/>)</t>
                                    </td>
                                </tr>
                                <tr t-foreach="item['cicilan']" t-as="cicilan">
                                    <td class="ps-4"><small>Cicilan <t t-out="cicilan_index + 1"/></small></td>
                                    <td><small t-out="cicilan['jatuh_tempo']" t-options="{'widget': 'date'}"/></td>
                                    <td class="text-end"><small t-out="cicilan['nominal']" t-options="{'widget': 'monetary', 'display_currency': uang}"/></td>
                                    <td/>
                                    <td/>
                                    <td class="text-end"><small t-out="cicilan['sisa']" t-options="{'widget': 'monetary', 'display_currency': uang}"/></td>
                                    <td/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <p t-if="not kartu['bulanan'] and not kartu['lainnya']" class="mt-3">
                    Belum ada tagihan pada tahun ajaran ini.
                </p>

                <div class="row justify-content-end mt-3">
                    <div class="col-6">
                        <table class="table table-sm">
                            <tr>
                                <td>Total Tagihan</td>
                                <td class="text-end"><span t-out="kartu['total_tagihan']" t-options="{'widget': 'monetary', 'display_currency': uang}"/></td>
                            </tr>
                            <tr>
                                <td>Total Dibayar</td>
                                <td class="text-end"><span t-out="kartu['total_bayar']" t-options="{'widget': 'monetary', 'display_currency': uang}"/></td>
                            </tr>
                            <tr>
                                <td><strong>Sisa</strong></td>
                                <td class="text-end"><strong t-out="kartu['sisa']" t-options="{'widget': 'monetary', 'display_currency': uang}"/></td>
                            </tr>
                            <tr>
                                <td>Saldo Kredit</td>
                                <td class="text-end"><span t-out="kartu['saldo_kredit']" t-options="{'widget': 'monetary', 'display_currency': uang}"/></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_kartu_spp">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="nti_edu_tagihan.report_kartu_spp_document" t-lang="o.lang"/>
            </t>
        </t>
    </template>
</odoo>
