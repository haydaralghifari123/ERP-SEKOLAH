<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sertifikasi_list" model="ir.ui.view">
        <field name="name">nti_edu.pegawai.sertifikasi.list</field>
        <field name="model">nti_edu.pegawai.sertifikasi</field>
        <field name="arch" type="xml">
            <list string="Sertifikasi">
                <field name="jenis"/>
                <field name="nomor"/>
                <field name="tahun"/>
                <field name="bidang"/>
                <field name="mapel_id"/>
                <field name="lampiran"/>
            </list>
        </field>
    </record>

    <record id="view_sertifikasi_form" model="ir.ui.view">
        <field name="name">nti_edu.pegawai.sertifikasi.form</field>
        <field name="model">nti_edu.pegawai.sertifikasi</field>
        <field name="arch" type="xml">
            <form string="Sertifikasi">
                <sheet>
                    <group>
                        <group>
                            <field name="jenis"/>
                            <field name="nomor"/>
                            <field name="tahun"/>
                        </group>
                        <group>
                            <field name="bidang"/>
                            <field name="mapel_id"/>
                            <field name="lampiran"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
