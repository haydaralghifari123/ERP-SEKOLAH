<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hari_libur_list" model="ir.ui.view">
        <field name="name">nti_edu.hari.libur.list</field>
        <field name="model">nti_edu.hari.libur</field>
        <field name="arch" type="xml">
            <list string="Hari Libur" editable="bottom">
                <field name="name"/>
                <field name="jenis"/>
                <field name="tanggal_mulai"/>
                <field name="tanggal_selesai"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="action_hari_libur" model="ir.actions.act_window">
        <field name="name">Hari Libur</field>
        <field name="res_model">nti_edu.hari.libur</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
