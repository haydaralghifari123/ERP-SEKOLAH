<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_komponen_list" model="ir.ui.view">
        <field name="name">nti_edu.tagihan.komponen.list</field>
        <field name="model">nti_edu.tagihan.komponen</field>
        <field name="arch" type="xml">
            <list string="Komponen Biaya">
                <field name="sequence" widget="handle"/>
                <field name="kode"/>
                <field name="name"/>
                <field name="jenis"/>
                <field name="periode_jenis_id"/>
                <field name="aturan_cicilan_id" optional="show"/>
                <field name="aturan_denda_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_komponen_form" model="ir.ui.view">
        <field name="name">nti_edu.tagihan.komponen.form</field>
        <field name="model">nti_edu.tagihan.komponen</field>
        <field name="arch" type="xml">
            <form string="Komponen Biaya">
                <sheet>
                    <widget name="web_ribbon" title="Diarsipkan" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="mis. SPP"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kode"/>
                            <field name="jenis"/>
                            <field name="periode_jenis_id" invisible="jenis != 'biaya'"
                                   required="jenis == 'biaya'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group invisible="jenis != 'biaya'">
                            <field name="aturan_masuk_id"/>
                            <field name="aturan_cicilan_id" placeholder="Tidak boleh dicicil"/>
                            <field name="aturan_denda_id" placeholder="Tanpa denda"/>
                        </group>
                        <group>
                            <field name="akun_pendapatan_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_komponen_search" model="ir.ui.view">
        <field name="name">nti_edu.tagihan.komponen.search</field>
        <field name="model">nti_edu.tagihan.komponen</field>
        <field name="arch" type="xml">
            <search string="Komponen Biaya">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('kode', 'ilike', self)]"/>
                <filter name="biaya" string="Biaya" domain="[('jenis', '=', 'biaya')]"/>
                <filter name="denda" string="Denda" domain="[('jenis', '=', 'denda')]"/>
                <separator/>
                <filter name="arsip" string="Diarsipkan" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_komponen" model="ir.actions.act_window">
        <field name="name">Komponen Biaya</field>
        <field name="res_model">nti_edu.tagihan.komponen</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
