        <field name="lang">{{ object.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="description">Dikirim ke wali penerima beberapa hari sebelum tagihan jatuh tempo (pengaturan unit Pengingat).</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p>Yth. <t t-out="object.name or ''">Bapak/Ibu</t>,</p>
    <p>
        Kami mengingatkan tagihan <t t-out="ctx.get('nti_edu_unit') and ctx['nti_edu_unit'].name or ''">unit sekolah</t>
        berikut akan segera jatuh tempo:
    </p>
    <table style="border-collapse: collapse;" cellpadding="4" border="1">
