<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jenjang_list" model="ir.ui.view">
        <field name="name">nti_edu.jenjang.list</field>
        <field name="model">nti_edu.jenjang</field>
        <field name="arch" type="xml">
            <list string="Jenjang">
                <field name="urutan" widget="handle"/>
                <field name="name"/>
                <field name="kode"/>
            </list>
        </field>
    </record>

    <record id="view_jenjang_form" model="ir.ui.view">
        <field name="name">nti_edu.jenjang.form</field>
        <field name="model">nti_edu.jenjang</field>
        <field name="arch" type="xml">
            <form string="Jenjang">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="kode"/>
                        <field name="urutan"/>
                    </group>
                    <field name="tingkat_ids">
                        <list editable="bottom">
                            <field name="urutan" widget="handle"/>
                            <field name="name"/>
                            <field name="is_akhir"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_jenjang" model="ir.actions.act_window">
        <field name="name">Jenjang &amp; Tingkat</field>
        <field name="res_model">nti_edu.jenjang</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
