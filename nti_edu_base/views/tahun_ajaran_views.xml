<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tahun_ajaran_list" model="ir.ui.view">
        <field name="name">nti_edu.tahun.ajaran.list</field>
        <field name="model">nti_edu.tahun.ajaran</field>
        <field name="arch" type="xml">
            <list string="Tahun Ajaran">
                <field name="name"/>
                <field name="tanggal_mulai"/>
                <field name="tanggal_selesai"/>
                <field name="is_aktif"/>
            </list>
        </field>
    </record>

    <record id="view_tahun_ajaran_form" model="ir.ui.view">
        <field name="name">nti_edu.tahun.ajaran.form</field>
        <field name="model">nti_edu.tahun.ajaran</field>
        <field name="arch" type="xml">
            <form string="Tahun Ajaran">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_aktif"/>
                        </group>
                        <group>
                            <field name="tanggal_mulai"/>
                            <field name="tanggal_selesai"/>
                        </group>
                    </group>
                    <field name="semester_ids">
                        <list editable="bottom">
                            <field name="jenis"/>
                            <field name="tanggal_mulai"/>
                            <field name="tanggal_selesai"/>
                            <field name="is_aktif"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tahun_ajaran" model="ir.actions.act_window">
        <field name="name">Tahun Ajaran &amp; Semester</field>
        <field name="res_model">nti_edu.tahun.ajaran</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
